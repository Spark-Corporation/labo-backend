<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.sparksam.securedx</groupId>
  <artifactId>secured-x</artifactId>
  <version>2026.05.09.2</version>
  <packaging>pom</packaging>
  <name>secured-x</name>
  <description>Authentication and authorization library for Spring Boot applications</description>
  <modules>
    <module>secured-x-jwt</module>
    <module>secured-x-core</module>
    <module>secured-x-provider-apple</module>
    <module>secured-x-provider-oidc</module>
    <module>secured-x-provider-local</module>
    <module>secured-x-rbac</module>
    <module>secured-x-subscription</module>
    <module>secured-x-spring-boot-starter</module>
  </modules>
  <distributionManagement>
    <repository>
      <id>playthora-releases</id>
      <url>https://nexus.sparksam.dev/repository/playthora-releases/</url>
    </repository>
    <snapshotRepository>
      <id>playthora-snapshots</id>
      <url>https://nexus.sparksam.dev/repository/playthora-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>
  <properties>
    <nimbus-jose-jwt.version>10.8</nimbus-jose-jwt.version>
    <java.version>17</java.version>
    <bouncycastle.version>1.78.1</bouncycastle.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <mockito.version>5.23.0</mockito.version>
    <jacoco.version>0.8.14</jacoco.version>
    <spring-boot.version>4.0.6</spring-boot.version>
    <revision>0.1.0-SNAPSHOT</revision>
    <lombok.version>1.18.44</lombok.version>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <junit-jupiter.version>6.0.3</junit-jupiter.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <assertj.version>3.27.7</assertj.version>
    <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
    <caffeine.version>3.1.8</caffeine.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-jwt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-provider-apple</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-provider-oidc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-provider-local</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-rbac</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.sparksam.securedx</groupId>
        <artifactId>secured-x-subscription</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-junit-jupiter</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <source>${java.version}</source>
            <target>${java.version}</target>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.5</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${jacoco.minimum.coverage}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.6.0</version>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
