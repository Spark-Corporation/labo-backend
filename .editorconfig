# Spotless is authoritative for Java formatting; this file exists so IDEs
# that don't run Spotless (or run it after the user types) start from the
# right defaults.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{yaml,yml,json,xml}]
indent_size = 2

[Makefile]
indent_style = tab
