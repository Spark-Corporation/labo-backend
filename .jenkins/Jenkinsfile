@Library('homelab-jenkins-library') _

pipeline {
  agent { label 'java' }
  tools  { jdk 'jdk-25-linux'; maven 'maven-3' }
  environment {
    PROJECT_NAME    = 'lims-backend'
    DOCKER_REGISTRY = 'registry.sparksam.dev'
    DOCKER_BUILDKIT = '1'
  }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
  }
  stages {
    stage('Clean Workspace') {
      steps {
        cleanWs()
        checkout scm
        script { env.CALVER = calver() }
      }
    }
    stage('Build & Verify') {
      steps {
        mavenBuild(goals: 'clean verify',
                   additionalArgs: "-Drevision=${CALVER}")
      }
      post {
        always {
          junit testResults: '**/target/surefire-reports/*.xml,**/target/failsafe-reports/*.xml',
                allowEmptyResults: true
        }
      }
    }
    stage('Mutation Testing') {
      steps {
        mavenBuild(goals: 'verify',
                   additionalArgs: "-Pmutation -Drevision=${CALVER}")
      }
    }
    stage('Dependency Check') {
      steps {
        mavenDependencyCheck(failBuildOnCVSS: 7,
                             nvdApiKeyCredentialId: 'nvd-api-key',
                             additionalArgs: "-Drevision=${CALVER}")
      }
    }
    stage('SonarQube Quality Gate') {
      steps {
        sonarQubeAnalysis(projectKey: 'org.sparkcorporation.lims:lims-backend',
                          projectName: 'LIMS Backend',
                          skipBuild: true,
                          failOnQualityGate: true)
      }
    }
    stage('Upload to Nexus') {
      when { branch 'main' }
      steps {
        mavenBuild(goals: 'deploy',
                   skipTests: true,
                   additionalArgs: "-Drevision=${CALVER}",
                   notify: false)
      }
    }
    stage('Build Docker Image') {
      when { branch 'main' }
      steps {
        sh "mvn -B -Pdocker package -DskipTests -Drevision=${CALVER}"
      }
    }
    stage('Trivy Image Scan') {
      when { branch 'main' }
      steps {
        sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${DOCKER_REGISTRY}/sparkcorporation/lims-backend:${CALVER}"
      }
    }
    stage('Push & Sign Image') {
      when { branch 'main' }
      steps {
        sh "mvn -B -Pdocker-deploy package -DskipTests -Drevision=${CALVER}"
      }
    }
  }
  post {
    success  { addGitLabMRComment comment: "Build #${env.BUILD_NUMBER} passed. [View](${env.BUILD_URL})" }
    unstable { addGitLabMRComment comment: "Build #${env.BUILD_NUMBER} unstable. [View](${env.BUILD_URL})" }
    failure  { addGitLabMRComment comment: "Build #${env.BUILD_NUMBER} failed. [View](${env.BUILD_URL})" }
    cleanup  { cleanWs() }
  }
}
